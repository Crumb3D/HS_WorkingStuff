<configs>
	<append xpath="/lootcontainers">
		<lootcontainer name="hsCooler" count="0" size="6,2" sound_open="UseActions/open_cooler" sound_close="UseActions/close_cooler" loot_quality_template="qualBaseTemplate">
			<item name="cobweb"/>
		</lootcontainer>
		<lootcontainer name="hsDrying" count="0" size="6,2" sound_open="UseActions/crate_wood_open" sound_close="UseActions/crate_wood_close" loot_quality_template="qualBaseTemplate">
			<item name="cobweb"/>
		</lootcontainer>
		<lootcontainer name="hsCompost" count="0" size="6,2" sound_open="UseActions/open_garbage" sound_close="UseActions/close_garbage" loot_quality_template="qualBaseTemplate">
			<item name="cobweb"/>
		</lootcontainer>
		<lootcontainer name="hsWashingLine" count="0" size="8,2" sound_open="UseActions/crate_wood_open" sound_close="UseActions/crate_wood_close" loot_quality_template="qualBaseTemplate">
			<item name="cobweb"/>
		</lootcontainer>
		<lootcontainer name="hsClothesAirer" count="0" size="6,1" sound_open="UseActions/crate_wood_open" sound_close="UseActions/crate_wood_close" loot_quality_template="qualBaseTemplate">
			<item name="cobweb"/>
		</lootcontainer>
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='seeds']">
		<item name="hsPlantedWheat1"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='seedsNoFlowers']">
		<item name="hsPlantedWheat1" count="3,5"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupCoffeeMaker01']">
		<item name="hsTeaBagsPJ" count="2,6" loot_prob_template="medLow"/>
		<item name="hsTeaBagsYorkie" count="2,6" loot_prob_template="medLow"/>
		<item name="hsMug" count="1" loot_prob_template="low"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupFoodCommon']">
		<item name="hsTeaBagsPJ" count="2,6" loot_prob_template="low"/>
		<item name="hsTeaBagsYorkie" count="2,6" loot_prob_template="low"/>
		<item name="hsFlour" count="1,2" loot_prob_template="low"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupElectricalDevices']">
		<item name="hsFuse5" count="1,4" loot_prob_template="med"/>
		<item name="hsFuse15" count="1,4" loot_prob_template="med"/>
		<item name="hsFuse30" count="1,2" loot_prob_template="low"/>
		<item name="hsFuse45" count="1,2" loot_prob_template="low"/>
		<item name="hsBreaker15" count="1" loot_prob_template="low"/>
		<item name="hsBreaker30" count="1" loot_prob_template="low"/>
	</append>

	<!-- Empty jars for flushing, filling, washing. Vanilla mostly veryLow except liquor piles. -->
	<set xpath="/lootcontainers/lootgroup[@name='groupFoodTrashCommon']/item[@name='drinkJarEmpty']/@loot_prob_template">med</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupFoodTrashCommon']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupFoodTrashUncommon']/item[@name='drinkJarEmpty']/@loot_prob_template">med</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupFoodTrashUncommon']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupDrinksCommon']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupDumpsterFood']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupCupboard01']/item[@name='drinkJarEmpty']/@loot_prob_template">med</set>
	<setattribute xpath="/lootcontainers/lootgroup[@name='groupCupboard01']/item[@name='drinkJarEmpty']" name="count">1,3</setattribute>
	<set xpath="/lootcontainers/lootgroup[@name='groupToilet01']/item[@name='drinkJarEmpty']/@loot_prob_template">high</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupToilet01']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupChem01']/item[@name='drinkJarEmpty']/@loot_prob_template">med</set>
	<setattribute xpath="/lootcontainers/lootgroup[@name='groupChem01']/item[@name='drinkJarEmpty']" name="count">1,3</setattribute>
	<set xpath="/lootcontainers/lootgroup[@name='groupBackpacks01']/item[@name='drinkJarEmpty']/@loot_prob_template">med</set>
	<setattribute xpath="/lootcontainers/lootgroup[@name='groupBackpacks01']/item[@name='drinkJarEmpty']" name="count">1,3</setattribute>
	<set xpath="/lootcontainers/lootgroup[@name='groupCampingTents01']/item[@name='drinkJarEmpty']/@loot_prob_template">med</set>
	<setattribute xpath="/lootcontainers/lootgroup[@name='groupCampingTents01']/item[@name='drinkJarEmpty']" name="count">1,3</setattribute>
	<set xpath="/lootcontainers/lootgroup[@name='groupLiquorSmall01']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupLiquorMed01']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<set xpath="/lootcontainers/lootgroup[@name='groupLiquorLarge01']/item[@name='drinkJarEmpty']/@count">1,3</set>
	<append xpath="/lootcontainers/lootgroup[@name='groupSinks01']">
		<item name="drinkJarEmpty" count="1,3" loot_prob_template="medHigh"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupBathtub01']">
		<item name="drinkJarEmpty" count="1,3" loot_prob_template="med"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupFoodCommon']">
		<item name="drinkJarEmpty" count="1,3" loot_prob_template="medLow"/>
	</append>
</configs>
