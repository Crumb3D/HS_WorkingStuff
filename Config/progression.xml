<configs>
	<!-- Every HS recipe needs a magazine level AND a perk rank. The perk check sits on each unlock, so reading alone is not enough. -->

	<!-- Electrician magazines + Advanced Engineering: cookers, sockets and switches at 25 (rank 1), fridge, fridge-freezer, freezer, boiler and air con at 45 (rank 2). -->
	<append xpath="/progression/crafting_skills/crafting_skill[@name='craftingElectrician']/effect_group">
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="25,100" value="1" tags="hsMicrowave,hsMicrowaveRetro,hsCoffeeMaker,hsCoffeeMakerCommercial,hsStoveOld,hsStoveModern,hsStoveWall,hsSocketUKSingle,hsSocketUKDouble,hsSocketUSSingle,hsSocketUSDouble,hsLightSwitchUK,hsLightSwitchUS,hsCookerSwitchUK">
			<requirement name="ProgressionLevel" progression_name="perkAdvancedEngineering" operation="GTE" value="1"/>
		</passive_effect>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="45,100" value="1" tags="hsFridge,hsFridgeWhite,hsFreezer,hsWaterHeater,hsAirCon,hsAirConCeiling">
			<requirement name="ProgressionLevel" progression_name="perkAdvancedEngineering" operation="GTE" value="2"/>
		</passive_effect>
	</append>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingElectrician']/display_entry[@name_key='electricianT1']/unlock_entry/@item" delim="," op="add">hsMicrowave,hsMicrowaveRetro,hsCoffeeMaker,hsCoffeeMakerCommercial,hsStoveOld,hsStoveModern,hsStoveWall,hsSocketUKSingle,hsSocketUKDouble,hsSocketUSSingle,hsSocketUSDouble,hsLightSwitchUK,hsLightSwitchUS,hsCookerSwitchUK</csv>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingElectrician']/display_entry[@name_key='electricianT2']/unlock_entry/@item" delim="," op="add">hsFridge,hsFridgeWhite,hsFreezer,hsWaterHeater,hsAirCon,hsAirConCeiling</csv>

	<!-- Workstation magazines + Advanced Engineering: plumbing and the thermometer with the dew collector (16, rank 1), radiators, shower, bath, washers and dryers with the dew gatherer (26, rank 2). -->
	<append xpath="/progression/crafting_skills/crafting_skill[@name='craftingWorkstations']/effect_group">
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="16,100" value="1" tags="hsPipeTool,hsPipeStraight,hsPipeCorner,hsPipeJoint,hsWaterIntake,hsWaterTank,hsSink,hsRainCatch,hsWaterCooler,hsThermometer">
			<requirement name="ProgressionLevel" progression_name="perkAdvancedEngineering" operation="GTE" value="1"/>
		</passive_effect>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="26,100" value="1" tags="hsRadiator,hsRadiatorCastIron,hsShower,hsBath,hsWasher,hsWasherVanilla,hsDryer,hsDryerVanilla">
			<requirement name="ProgressionLevel" progression_name="perkAdvancedEngineering" operation="GTE" value="2"/>
		</passive_effect>
	</append>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingWorkstations']/display_entry[contains(@name_key,'workstationsT2-1')]/unlock_entry[@unlock_tier='1']/@item" delim="," op="add">hsPipeTool,hsPipeStraight,hsPipeCorner,hsPipeJoint,hsWaterIntake,hsWaterTank,hsSink,hsRainCatch,hsWaterCooler,hsThermometer</csv>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingWorkstations']/display_entry[contains(@name_key,'workstationsT2-1')]/unlock_entry[@unlock_tier='5']/@item" delim="," op="add">hsRadiator,hsRadiatorCastIron,hsShower,hsBath,hsWasher,hsWasherVanilla,hsDryer,hsDryerVanilla</csv>

	<!-- Home Cooking magazines + Master Chef: drying rack, dried meat and charcoal grill at 6, cooler at 10 (rank 1), gas grill at 26 (rank 2). -->
	<append xpath="/progression/crafting_skills/crafting_skill[@name='craftingFood']/effect_group">
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="6,100" value="1" tags="hsDryingRack,hsDriedMeat,hsCharcoalGrill">
			<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="GTE" value="1"/>
		</passive_effect>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="10,100" value="1" tags="hsCooler">
			<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="GTE" value="1"/>
		</passive_effect>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="26,100" value="1" tags="hsGasGrill">
			<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="GTE" value="2"/>
		</passive_effect>
	</append>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingFood']/display_entry[contains(@name_key,'foodT1-1')]/unlock_entry[@unlock_tier='3']/@item" delim="," op="add">hsDryingRack,hsDriedMeat,hsCharcoalGrill</csv>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingFood']/display_entry[contains(@name_key,'foodT1-1')]/unlock_entry[@unlock_tier='5']/@item" delim="," op="add">hsCooler</csv>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingFood']/display_entry[contains(@name_key,'foodT2-1')]/unlock_entry[@unlock_tier='5']/@item" delim="," op="add">hsGasGrill</csv>

	<!-- Seed magazines + Living Off The Land: compost at 10 (rank 1). -->
	<append xpath="/progression/crafting_skills/crafting_skill[@name='craftingSeeds']/effect_group">
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="10,100" value="1" tags="hsCompost">
			<requirement name="ProgressionLevel" progression_name="perkLivingOffTheLand" operation="GTE" value="1"/>
		</passive_effect>
	</append>
	<csv xpath="/progression/crafting_skills/crafting_skill[@name='craftingSeeds']/display_entry[contains(@name_key,'seedsT1-1')]/unlock_entry[@unlock_tier='5']/@item" delim="," op="add">hsCompost</csv>
</configs>
