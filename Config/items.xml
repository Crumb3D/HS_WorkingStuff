			<property name="CustomIcon" value="foodCharredMeat" />
			<property name="SpoilDays" value="21" />
		</item>
		<item name="hsPipeTool">
			<property name="UnlockedBy" value="craftingWorkstations,perkAdvancedEngineering" />
			<property name="Tags" value="tool,noMods"/>
			<property name="CreativeMode" value="Player"/>
			<property name="HoldType" value="29"/>
			<property name="Meshfile" value="@:Other/Items/Tools/wrenchPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="CustomIcon" value="meleeToolSalvageT1Wrench"/>
			<property name="CustomIconTint" value="3a8fd8"/>
			<property name="TintColor" value="58, 143, 216"/>
			<property name="Material" value="Mmetal"/>
			<property name="DescriptionKey" value="hsPipeToolDesc"/>
			<property name="Stacknumber" value="1"/>
			<property name="DegradationBreaksAfter" value="false"/>
			<property name="EconomicValue" value="40"/>
			<property name="SellableToTrader" value="false"/>
			<property name="SoundUnholster" value="weapon_unholster"/>
			<property name="SoundHolster" value="weapon_holster"/>
			<property name="SoundPickup" value="wrench_grab"/>
			<property name="SoundPlace" value="wrench_place"/>
			<property class="Action0">
				<property name="Class" value="HSPipeTool, HSWorkingStuff"/>
			</property>
			<property class="Action1">
				<property name="Class" value="HSPipeTool, HSWorkingStuff"/>
			</property>
			<property name="Group" value="Tools/Traps,Building"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_plumbing"/>
		</item>

		<!-- Wheat to bread to toast -->
		<item name="hsCropWheat">
			<property name="HoldType" value="45"/>
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
