			<property name="Extends" value="foodRottingFlesh" />
			<property name="DescriptionKey" value="hsSpoiledFoodDesc" />
			<property name="CustomIcon" value="foodRottingFlesh" />
			<property name="CustomIconTint" value="6B4F2A" />
		</item>
		<item name="hsDriedMeat">
			<property name="UnlockedBy" value="craftingFood,perkMasterChef" />
