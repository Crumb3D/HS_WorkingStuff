		<item name="hsMugTeaPJ">
			<property name="Tags" value="drinks,foodSkill,fitness"/>
			<property name="HoldType" value="3"/>
			<property name="DisplayType" value="waterCoffee"/>
			<property name="Meshfile" value="@:Other/Items/Food/masonJarRedTeaPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Mglass"/>
			<property name="Stacknumber" value="10"/>
			<property name="EconomicValue" value="60"/>
			<property name="UnlockedBy" value="craftingFood,perkMasterChef"/>
			<property name="DescriptionKey" value="hsMugTeaPJDesc"/>
			<property name="SoundPickup" value="jars_grab"/>
			<property name="SoundPlace" value="jars_place"/>
			<property class="Action0">
				<property name="Class" value="Eat"/>
				<property name="Delay" value="4"/>
				<property name="Sound_start" value="player_drinking"/>
				<property name="Create_item" value="hsMug"/>
			</property>
			<property name="Group" value="Food/Cooking,CFDrink/Cooking"/>
			<effect_group tiered="false" name="Drink Tier 1">
				<requirement name="!HasBuff" buff="buffIsOnFire"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$waterAmountAdd" operation="add" value="28"/>
				<display_value name="dStaminaRegen" value=".2"/>
				<display_value name="dHypothermalResist" value="5"/>
				<display_value name="dDuration" value="120"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$buffCoffeeDuration" operation="add" value="123"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$buffCoffeeDuration" operation="set" value="543">
					<requirement name="CVarCompare" cvar="$buffCoffeeDuration" operation="GT" value="543"/></triggered_effect>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffProcessConsumables,buffCoffee"/>
			</effect_group>
			<effect_group tiered="false">
				<requirement name="HasBuff" buff="buffIsOnFire"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffExtinguishFire"/>
			</effect_group>
		</item>
		<item name="hsMugTeaYorkie">
			<property name="Extends" value="hsMugTeaPJ"/>
			<property name="DescriptionKey" value="hsMugTeaYorkieDesc"/>
			<effect_group tiered="false" name="Drink Tier 1">
				<requirement name="!HasBuff" buff="buffIsOnFire"/>
