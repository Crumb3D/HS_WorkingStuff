			<property name="Stacknumber" value="500"/>
			<property name="EconomicValue" value="8"/>
			<property name="CraftingIngredientTime" value="5"/>
			<property name="DescriptionKey" value="hsCropWheatDesc"/>
			<property name="Group" value="Food/Cooking,CFFood/Cooking"/>
			<property name="SoundPickup" value="coffeebeans_grab"/>
			<property name="SoundPlace" value="coffeebeans_place"/>
		</item>
		<item name="hsFlour">
			<property name="Extends" value="hsCropWheat"/>
