<configs>
	<append xpath="/xui">
		<window_group name="hsWorkingStorage" controller="HSStorageWindowGroup, HSWorkingStuff" open_backpack_on_open="true" close_compass_on_open="true">
			<window name="windowHSStorage" />
			<window name="windowNonPagingHeader" />
		</window_group>
		<window_group name="hsRainCatch" controller="HSRainCatchWindowGroup, HSWorkingStuff" open_backpack_on_open="true" close_compass_on_open="true">
			<window name="windowHSRainCatch" />
			<window name="windowNonPagingHeader" />
		</window_group>
		<window_group name="workstation_hsStove" controller="XUiC_WorkstationWindowGroup" open_backpack_on_open="true" close_compass_on_open="true" defaultselected="bp.content">
			<window name="windowCraftingList"/>
			<window name="craftingInfoPanel"/>
			<window name="windowCraftingQueue"/>
			<window name="windowToolsCampfire" />
			<window name="windowHSStovePower" />
			<window name="windowOutput" />
			<window name="windowNonPagingHeader" />
		</window_group>
		<window_group name="workstation_hsMicrowave" controller="XUiC_WorkstationWindowGroup" open_backpack_on_open="true" close_compass_on_open="true" defaultselected="bp.content">
			<window name="windowCraftingList"/>
			<window name="craftingInfoPanel"/>
			<window name="windowCraftingQueue"/>
			<window name="windowHSStovePower" />
			<window name="windowOutput" />
			<window name="windowNonPagingHeader" />
		</window_group>
		<window_group name="workstation_hsGrill" controller="XUiC_WorkstationWindowGroup" open_backpack_on_open="true" close_compass_on_open="true" defaultselected="bp.content">
			<window name="windowCraftingList"/>
			<window name="craftingInfoPanel"/>
			<window name="windowCraftingQueue"/>
			<window name="windowFuel" />
			<window name="windowOutput" />
			<window name="windowNonPagingHeader" />
		</window_group>
	</append>
	<append xpath="/xui/window_group[@name='toolbelt']">
		<window name="HUDHSPipe"/>
	</append>
</configs>
